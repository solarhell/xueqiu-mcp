{
	"name": "xueqiu-mcp",
	"version": "1.1.1",
	"description": "雪球股票数据 MCP Server",
	"type": "module",
	"bin": {
		"xueqiu-mcp": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"start": "bun run index.ts",
		"start:http": "MCP_TRANSPORT_TYPE=http bun run index.ts",
		"build": "bun build index.ts --target=node --outdir=dist",
		"check": "biome check",
		"fix": "biome check --fix",
		"inspector:web": "bunx @modelcontextprotocol/inspector --config mcp.json --server xueqiu-mcp",
		"inspector:cli": "bunx @modelcontextprotocol/inspector --cli --config mcp.json --server xueqiu-mcp",
		"prepublishOnly": "bun run build"
	},
	"keywords": [
		"mcp",
		"xueqiu",
		"stock",
		"finance"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/solarhell/xueqiu-mcp.git"
	},
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@types/bun": "^1.3.14"
	},
	"peerDependencies": {
		"typescript": "^6"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.4",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"hono": "^4.12.23"
	}
}
